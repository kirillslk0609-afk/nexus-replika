      {
        "speaker_id": "speaker_1",
        "start_ms": 72680,
        "end_ms": 73920,
        "text": "проли в стощее"
      },
      {
        "speaker_id": "speaker_2",
        "start_ms": 76060,
        "end_ms": 79140,
        "text": "Не жал, мне нормально. Данил, никто мне не звонил."
      },
      {
        "speaker_id": "speaker_2",
        "start_ms": 81200,
        "end_ms": 82380,
        "text": "Дома сидел вчера"
      },
      {
        "speaker_id": "speaker_2",
        "start_ms": 85000,
        "end_ms": 86520,
        "text": "Ни за умянь, сих"
      },
      {
        "speaker_id": "speaker_2",
        "start_ms": 88840,
        "end_ms": 91060,
        "text": "Он так что везет, а?"
      },
      {
        "speaker_id": "speaker_1",
        "start_ms": 94200,
        "end_ms": 96520,
        "text": "Я с прерывистыми все равно пропадаю."
      },
      {
        "speaker_id": "speaker_1",
        "start_ms": 98940,
        "end_ms": 100720,
        "text": "Погоди я этот выхмит."
