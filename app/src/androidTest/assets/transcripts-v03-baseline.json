      {
        "speaker_id": "speaker_2",
        "start_ms": 57840,
        "end_ms": 58120,
        "text": "в"
      },
      {
        "speaker_id": "speaker_1",
        "start_ms": 60180,
        "end_ms": 60560,
        "text": "Т"
      },
      {
        "speaker_id": "speaker_2",
        "start_ms": 61660,
        "end_ms": 62080,
        "text": "Мус"
      },
      {
        "speaker_id": "speaker_2",
        "start_ms": 63120,
        "end_ms": 63520,
        "text": "уй"
      },
      {
        "speaker_id": "speaker_1",
        "start_ms": 64620,
        "end_ms": 65760,
        "text": "Отчеркоте"
      },
      {
        "speaker_id": "speaker_2",
        "start_ms": 68700,
        "end_ms": 69780,
        "text": "...ммммм"
