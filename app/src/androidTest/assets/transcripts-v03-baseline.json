      {
        "speaker_id": "speaker_1",
        "start_ms": 17820,
        "end_ms": 19900,
        "text": "Вау!"
      },
      {
        "speaker_id": "speaker_1",
        "start_ms": 22500,
        "end_ms": 23700,
        "text": "А это же ладий"
