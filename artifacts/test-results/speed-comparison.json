        "result": {
          "transcript": [
            {
              "speaker_id": "speaker_1",
              "start_ms": 7000,
              "end_ms": 7560,
              "text": "Алло!"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 8240,
              "end_ms": 8700,
              "text": "а да"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 9220,
              "end_ms": 9600,
              "text": "Чё"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 10120,
              "end_ms": 10940,
              "text": "Что делаем?"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 12120,
              "end_ms": 12640,
              "text": "- Алло"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 13760,
              "end_ms": 14820,
              "text": "Дууууу"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 14580,
              "end_ms": 15520,
              "text": "Что делаем, М"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 17500,
              "end_ms": 24620,
              "text": "а я жду 2 а ну давай один или один"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 17820,
              "end_ms": 19900,
              "text": "Вау!"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 22500,
              "end_ms": 23700,
              "text": "А это же ладий"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 26300,
              "end_ms": 26940,
              "text": "Ага."
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 26740,
              "end_ms": 28360,
              "text": "-Ага, то есть..."
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 28740,
              "end_ms": 29080,
              "text": "До"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 29960,
              "end_ms": 31000,
              "text": "Точно-но точно."
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 33500,
              "end_ms": 34000,
              "text": "Кр"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 34920,
              "end_ms": 36520,
              "text": "Я еще один никуда не хотел ех."
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 39360,
              "end_ms": 40340,
              "text": "то не наверное."
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 41500,
              "end_ms": 45280,
              "text": "Всегда базы бы надо съездить, что никак не облить на ворота по газ"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 49520,
              "end_ms": 52360,
              "text": "И так выложим. Желаем, чтобы выросли."
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 51540,
              "end_ms": 52500,
              "text": "Эдр!"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 52940,
              "end_ms": 55500,
              "text": "Чего Кусана прыгал, да? Злоде"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 57840,
              "end_ms": 58120,
              "text": "в"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 60180,
              "end_ms": 60560,
              "text": "Т"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 61660,
              "end_ms": 62080,
              "text": "Мус"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 63120,
              "end_ms": 63520,
              "text": "уй"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 64620,
              "end_ms": 65760,
              "text": "Отчеркоте"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 68700,
              "end_ms": 69780,
              "text": "...ммммм"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 69940,
              "end_ms": 72120,
              "text": "что-то от прирыва и стыдно"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 72680,
              "end_ms": 73920,
              "text": "проли в стощее"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 76060,
              "end_ms": 79140,
              "text": "Не жал, мне нормально. Данил, никто мне не звонил."
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 81200,
              "end_ms": 82380,
              "text": "Дома сидел вчера"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 85000,
              "end_ms": 86520,
              "text": "Ни за умянь, сих"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 88840,
              "end_ms": 91060,
              "text": "Он так что везет, а?"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 94200,
              "end_ms": 96520,
              "text": "Я с прерывистыми все равно пропадаю."
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 98940,
              "end_ms": 100720,
              "text": "Погоди я этот выхмит."
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 105120,
              "end_ms": 107220,
              "text": "называется это."
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 112500,
              "end_ms": 112740,
              "text": "в"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 113380,
              "end_ms": 115440,
              "text": "Да, нет, ну мне мить их очень хорошо."
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 116360,
              "end_ms": 117120,
              "text": "Лону"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 117700,
              "end_ms": 118280,
              "text": "Иди давай"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 121340,
              "end_ms": 124300,
              "text": "Потому что ты начинаешь так и говоришь, что это нормально, а потом..."
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 124640,
              "end_ms": 125920,
              "text": "конец почти что это"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 126300,
              "end_ms": 128200,
              "text": "Пропадает, уходит вон."
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 130540,
              "end_ms": 132500,
              "text": "Не знамись, не конец"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 132500,
              "end_ms": 134520,
              "text": "не одевался я смотрю за ним"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 137700,
              "end_ms": 138540,
              "text": "И ясно."
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 140740,
              "end_ms": 144360,
              "text": "Ну если что, тогда заедешь."
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 141400,
              "end_ms": 143820,
              "text": "Ну если что-то, то это всё так."
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 147000,
              "end_ms": 147500,
              "text": "Наши"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 147140,
              "end_ms": 149720,
              "text": "Я сейчас пока дома буду, сейчас будешь..."
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 152300,
              "end_ms": 154940,
              "text": "Да нет, я сейчас машинку буду, видишь, делаю"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 156640,
              "end_ms": 157100,
              "text": "Ну..."
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 157920,
              "end_ms": 159200,
              "text": "Да, это не очень много"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 158700,
              "end_ms": 160320,
              "text": "А, уже подключал."
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 161100,
              "end_ms": 162500,
              "text": "но запускать"
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 162720,
              "end_ms": 164340,
              "text": "Ну давай, ладно, я с учен"
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 164760,
              "end_ms": 165860,
              "text": "Я вас хочу."
            },
            {
              "speaker_id": "speaker_2",
              "start_ms": 166400,
              "end_ms": 166780,
              "text": "А..."
            },
            {
              "speaker_id": "speaker_1",
              "start_ms": 167880,
              "end_ms": 168180,
              "text": "да"
            }
          ]
        }
